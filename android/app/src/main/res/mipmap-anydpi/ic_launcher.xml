<?xml version="1.0" encoding="utf-8"?>
<!--
  The iOS app icon is a full-bleed square design, so it is used as the
  adaptive icon's *background* layer: Android then crops it to whichever mask
  the launcher uses, which reproduces the iOS icon rather than shrinking it
  onto a coloured plate.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
