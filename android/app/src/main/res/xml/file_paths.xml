<?xml version="1.0" encoding="utf-8"?>
<!--
  Exposes only the cache directory - where EvidenceReport writes its PDF and
  where session archive files are staged for sharing - to the share sheet's
  target app, via a content:// URI rather than a raw file path. Nothing else
  in the app's storage is reachable through this provider.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="evidence" path="." />
    <files-path name="archive" path="archive/" />
    <files-path name="cases" path="cases/items/" />
</paths>
