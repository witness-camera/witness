    "Connect cloud storage on the home screen so your recordings reach the crew. Until then they stay on this iPhone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde auf dem Startbildschirm einen Cloud-Speicher, damit deine Aufnahmen die Crew erreichen. Bis dahin bleiben sie auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta un almacenamiento en la nube en la pantalla principal para que tus grabaciones lleguen al equipo. Mientras tanto se quedan en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
