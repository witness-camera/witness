    "What one phone misses, another catches: the start of an arrest, a face, a badge number." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ein Handy verpasst, erfasst ein anderes: den Beginn einer Festnahme, ein Gesicht, eine Dienstnummer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que un teléfono se pierde, otro lo capta: el inicio de una detención, una cara, un número de placa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qu'un téléphone rate, un autre le capte : le début d'une interpellation, un visage, un matricule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello che un telefono perde, un altro lo riprende: l'inizio di un fermo, un volto, un numero di matricola."
          }
        }
      }
    },
