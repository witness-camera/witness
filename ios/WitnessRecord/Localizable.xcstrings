    "Your recordings and their proofs are kept either way. Pro adds the report that turns them into something an attorney or an editor can read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufnahmen und ihre Nachweise bleiben ohnehin erhalten. Pro ergänzt den Bericht, der sie für Anwältinnen oder Redaktionen lesbar macht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grabaciones y sus pruebas se conservan en cualquier caso. Pro añade el informe que las hace legibles para un abogado o una redacción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos enregistrements et leurs preuves sont conservés dans tous les cas. Pro ajoute le rapport qui les rend lisibles par un avocat ou une rédaction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue registrazioni e le loro prove vengono conservate in ogni caso. Pro aggiunge il report che le rende leggibili a un avvocato o a una redazione."
          }
        }
      }
    },
