    "Nothing found yet? Both phones need this screen open, and Local Network allowed for Witness in Settings > Privacy & Security > Local Network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts gefunden? Auf beiden Handys muss dieser Bildschirm offen und das lokale Netzwerk für Witness erlaubt sein: Einstellungen > Datenschutz & Sicherheit > Lokales Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Aún nada? Los dos teléfonos necesitan esta pantalla abierta y la Red local permitida para Witness en Ajustes > Privacidad y seguridad > Red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours rien ? Les deux téléphones doivent avoir cet écran ouvert, et le Réseau local autorisé pour Witness dans Réglages > Confidentialité et sécurité > Réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente? Entrambi i telefoni devono avere questa schermata aperta e la Rete locale consentita per Witness in Impostazioni > Privacy e sicurezza > Rete locale."
          }
        }
      }
    },
    "Nothing here yet" : {
