            "value" : "%@ · automatica, verificala con la registrazione"
          }
        }
      }
    },
    "%@ · automatic, made on Apple's servers. Check it against the recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · automatisch, auf Apples Servern erstellt. Mit der Aufnahme abgleichen."
