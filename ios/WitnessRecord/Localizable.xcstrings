          }
        }
      }
    },
    "Recordings stay in your case and cloud. Folders already shared stay shared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen bleiben in deinem Fall und deiner Cloud. Bereits geteilte Ordner bleiben geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones se quedan en tu caso y en tu nube. Las carpetas ya compartidas siguen compartidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements restent dans votre dossier et votre cloud. Les dossiers déjà partagés le restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le registrazioni restano nel tuo caso e nel cloud. Le cartelle già condivise restano condivise."
          }
        }
      }
    },
    "Recordings upload to an account you own. Witness has no server of its own and keeps no copy: the developer cannot see your footage on any of these services." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen werden in ein Konto hochgeladen, das dir gehört. Witness hat keinen eigenen Server und behält keine Kopie: Der Entwickler kann deine Aufnahmen bei keinem dieser Dienste sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones se suben a una cuenta de tu propiedad. Witness no tiene servidor propio ni guarda copias: el desarrollador no puede ver tus grabaciones en ninguno de estos servicios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements sont envoyés vers un compte qui vous appartient. Witness n'a pas de serveur et n'en conserve aucune copie : le développeur ne peut voir vos vidéos sur aucun de ces services."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le registrazioni vengono caricate su un account che possiedi tu. Witness non ha un proprio server e non conserva copie: lo sviluppatore non può vedere i tuoi filmati su nessuno di questi servizi."
          }
        }
      }
    },
    "Recordings won't upload to Drive" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen werden nicht zu Drive hochgeladen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones no se subirán a Drive"
          }
        },
        "fr" : {
