    "Clock matched to within %lld ms." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhr auf %lld ms genau abgeglichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reloj sincronizado con un margen de %lld ms."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horloge synchronisée à %lld ms près."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orologio allineato entro %lld ms."
          }
        }
      }
    },
    "Clock not matched yet: open this screen near a crew member who is. Until then the phone's own time is used, usually within a fraction of a second." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhr noch nicht abgeglichen: Öffne diesen Bildschirm in der Nähe eines abgeglichenen Crew-Mitglieds. Bis dahin wird die Uhrzeit des Handys genutzt, meist auf Sekundenbruchteile genau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reloj aún sin sincronizar: abre esta pantalla cerca de un miembro del equipo que sí lo esté. Mientras tanto se usa la hora del teléfono, normalmente precisa a una fracción de segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horloge pas encore synchronisée : ouvrez cet écran près d'un membre de l'équipe qui l'est. En attendant, l'heure du téléphone est utilisée, en général à une fraction de seconde près."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orologio non ancora allineato: apri questa schermata vicino a un membro della crew che lo è. Fino ad allora si usa l'ora del telefono, di solito precisa entro una frazione di secondo."
          }
        }
      }
    },
    "Clocks are matched, so every angle lines up to the second. Export it as one multicam edit for Final Cut, Premiere or Resolve." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhren werden abgeglichen, sodass jeder Blickwinkel sekundengenau passt. Exportiere alles als einen Multicam-Schnitt für Final Cut, Premiere oder Resolve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los relojes se sincronizan, así que cada ángulo encaja al segundo. Expórtalo como una sola edición multicámara para Final Cut, Premiere o Resolve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les horloges sont synchronisées : chaque angle s'aligne à la seconde. Exportez un seul montage multicam pour Final Cut, Premiere ou Resolve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli orologi vengono allineati, così ogni angolazione combacia al secondo. Esportala come un unico montaggio multicamera per Final Cut, Premiere o Resolve."
          }
        }
      }
    },
