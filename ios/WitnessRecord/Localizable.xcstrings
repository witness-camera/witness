    "Add your name and email so the crew can see you've joined and send you their footage. Shared only with your crew." : {
      "comment" : "A description of the privacy of the user's email.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deinen Namen und deine E-Mail an, damit die Crew sieht, dass du dabei bist, und dir ihr Material schicken kann. Nur mit deiner Crew geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu nombre y correo para que el equipo vea que te has unido y pueda enviarte su material. Solo se comparten con tu equipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez votre nom et votre e-mail pour que l'équipe voie que vous l'avez rejointe et puisse vous envoyer ses images. Partagés uniquement avec votre équipe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi nome ed email così la crew vede che ti sei unito e può inviarti il suo materiale. Condivisi solo con la tua crew."
          }
        }
      }
    },
    "Added, they'll be notified once you start recording." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinzugefügt, er wird benachrichtigt, sobald du mit der Aufnahme beginnst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadido, se le notificará en cuanto empieces a grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouté, il sera notifié dès que vous commencerez à enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunto, verrà avvisato non appena inizi a registrare."
