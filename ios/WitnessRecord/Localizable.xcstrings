    "Bugs and ideas welcome." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler und Ideen willkommen."
          }
        },
        "es" : {
          "stringUnit" : {
