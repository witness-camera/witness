          }
        }
      }
    },
    "Address and unit" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse und Wohnung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirección y piso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse et logement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indirizzo e interno"
          }
        }
      }
    },
    "After a long recording, give it a few seconds. The video is assembled as you film, so it should appear almost immediately." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte nach einer langen Aufnahme ein paar Sekunden. Das Video wird schon beim Filmen zusammengesetzt und sollte fast sofort erscheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una grabación larga, espera unos segundos. El video se monta mientras grabas, así que debería aparecer casi enseguida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un long enregistrement, patientez quelques secondes. La vidéo est assemblée pendant que vous filmez, elle devrait donc apparaître presque immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo una registrazione lunga, aspetta qualche secondo. Il video viene composto mentre filmi, quindi dovrebbe comparire quasi subito."
          }
        }
      }
    },
    "Afterwards, open the crew and tap “Make multicam edit files” for Final Cut, Premiere or DaVinci Resolve." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne danach die Crew und tippe auf „Multicam-Schnittdateien erstellen“ für Final Cut, Premiere oder DaVinci Resolve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después, abre el equipo y toca «Crear archivos de edición multicámara» para Final Cut, Premiere o DaVinci Resolve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, ouvrez l'équipe et touchez « Créer les fichiers de montage multicam » pour Final Cut, Premiere ou DaVinci Resolve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo, apri la crew e tocca “Crea i file per il montaggio multicamera” per Final Cut, Premiere o DaVinci Resolve."
          }
        }
      }
    },
    "Agency or department" : {
      "extractionState" : "stale",
      "localizations" : {
