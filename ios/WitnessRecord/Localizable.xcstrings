    "Recording shows a live preview.\nTriple-tap, then hold the stop icon to end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme zeigt eine Live-Vorschau.\nTippe dreimal, halte dann das Stopp-Symbol gedrückt, um zu beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación muestra una vista previa en directo.\nToca tres veces y luego mantén pulsado el icono de detener para finalizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement affiche un aperçu en direct.\nAppuyez trois fois, puis maintenez l'icône d'arrêt pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione mostra un'anteprima dal vivo.\nTocca tre volte, poi tieni premuta l'icona di stop per terminare."
          }
        }
      }
    },
    "Recording stays on this device" : {
