      "isCommentAutoGenerated" : true
    },
    "%@ can't grant access automatically: emergency contacts with an email won't be notified or given access to your recordings. Switch to a provider that supports sharing, or share a folder yourself from that account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann den Zugriff nicht automatisch gewähren: Notfallkontakte mit E-Mail werden nicht benachrichtigt und erhalten keinen Zugriff auf deine Aufnahmen. Wechsle zu einem Anbieter, der Freigaben unterstützt, oder gib selbst einen Ordner aus diesem Konto frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede conceder acceso automáticamente: los contactos de emergencia con correo no serán avisados ni tendrán acceso a tus grabaciones. Cambia a un proveedor que permita compartir, o comparte tú una carpeta desde esa cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas accorder l'accès automatiquement : les contacts d'urgence avec une adresse e-mail ne seront pas prévenus ni n'auront accès à vos enregistrements. Passez à un fournisseur qui permet le partage, ou partagez vous-même un dossier depuis ce compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non può concedere l'accesso automaticamente: i contatti di emergenza con un'email non verranno avvisati né avranno accesso alle tue registrazioni. Passa a un provider che supporta la condivisione, oppure condividi tu una cartella da quell'account."
          }
        }
      }
    },
