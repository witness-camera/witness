    "Not through this app. There is no delete button anywhere in Witness, and it only ever adds files to your storage account." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht über diese App. In Witness gibt es nirgends eine Löschtaste, und sie fügt deinem Speicherkonto immer nur Dateien hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No a través de esta app. En Witness no hay ningún botón de borrar, y solo añade archivos a tu cuenta de almacenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas via cette app. Il n'y a aucun bouton de suppression dans Witness, et elle ne fait qu'ajouter des fichiers à votre compte de stockage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non tramite questa app. In Witness non c'è alcun pulsante per eliminare, e si limita ad aggiungere file al tuo account di archiviazione."
          }
        }
      }
    },
