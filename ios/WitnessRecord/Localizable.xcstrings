            "value" : "Pro trascrive le registrazioni e cerca in ogni caso"
          }
        }
      }
    },
    "Pro transcribes your recordings and lets you search everything that was said, across every case." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro transkribiert deine Aufnahmen und durchsucht alles Gesagte in allen Fällen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro transcribe tus grabaciones y te permite buscar todo lo que se dijo, en todos los casos."
          }
        },
        "fr" : {
          "stringUnit" : {
