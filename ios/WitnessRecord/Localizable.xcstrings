    "Stabilization from off to extreme, for walking or running." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilisierung von aus bis extrem, für Gehen oder Laufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estabilización de desactivada a extrema, para caminar o correr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilisation de désactivée à extrême, pour marcher ou courir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilizzazione da disattivata a estrema, per camminare o correre."
          }
        }
      }
    },
    "Standard" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estándar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard"
          }
        }
      }
    },
    "Standard smooths small shakes with almost no crop. Cinematic is steadier and crops in more. Extreme is the steadiest, for walking or running, and crops in the most. Off keeps the full frame with no smoothing." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard glättet kleine Wackler fast ohne Beschnitt. Kinematisch ist ruhiger und schneidet mehr ab. Extrem ist am ruhigsten, für Gehen oder Laufen, und schneidet am meisten ab. Aus behält das volle Bild ohne Glättung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estándar suaviza pequeñas sacudidas casi sin recorte. Cinematográfica es más estable y recorta más. Extrema es la más estable, para caminar o correr, y recorta más. Desactivada mantiene el encuadre completo sin suavizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard atténue les petites secousses presque sans recadrage. Cinématique est plus stable et recadre davantage. Extrême est la plus stable, pour marcher ou courir, et recadre le plus. Désactivée garde l'image entière, sans lissage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard attenua i piccoli tremolii quasi senza ritaglio. Cinematografica è più stabile e ritaglia di più. Estrema è la più stabile, per camminare o correre, e ritaglia di più. Disattivata mantiene l'inquadratura intera senza stabilizzare."
          }
        }
      }
    },
    "Start" : {
