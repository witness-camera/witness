    "Everything in the free app stays free. Pro only adds capture quality." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles Kostenlose bleibt kostenlos. Pro ergänzt nur die Aufnahmequalität."
