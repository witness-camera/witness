    "Uploaded while you film, in 15-second pieces, one at a time. Each session gets its own folder named after the date, time and place." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird während des Filmens hochgeladen, in 15-Sekunden-Teilen, einer nach dem anderen. Jede Sitzung bekommt einen eigenen Ordner, benannt nach Datum, Uhrzeit und Ort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sube mientras grabas, en piezas de 15 segundos, una a una. Cada sesión tiene su propia carpeta con la fecha, la hora y el lugar en el nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé pendant que vous filmez, par morceaux de 15 secondes, un à la fois. Chaque session a son propre dossier nommé d'après la date, l'heure et le lieu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caricata mentre filmi, a pezzi di 15 secondi, uno alla volta. Ogni sessione ha la sua cartella con data, ora e luogo nel nome."
          }
        }
      }
    },
