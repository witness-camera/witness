    "Not legal advice. Check your local laws, stay safe, and announce you're recording if you can." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist keine Rechtsberatung. Prüfe deine örtlichen Gesetze, bleib sicher und kündige, wenn möglich, an, dass du aufnimmst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no es asesoramiento legal. Consulta tus leyes locales, mantente a salvo y anuncia que estás grabando si puedes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci ne constitue pas un conseil juridique. Vérifiez les lois locales, restez en sécurité et annoncez que vous filmez si possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è una consulenza legale. Verifica le leggi locali, resta al sicuro e, se puoi, annuncia che stai registrando."
          }
        }
      }
    },
