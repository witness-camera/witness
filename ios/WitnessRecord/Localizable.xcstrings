    "Imported files are hashed and time-stamped when they're imported. That proves they haven't changed since then, not when they were made." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importierte Dateien erhalten beim Import einen Hash und einen Zeitstempel. Das beweist, dass sie seitdem unverändert sind, nicht wann sie entstanden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos importados reciben hash y sello de tiempo al importarse. Eso prueba que no han cambiado desde entonces, no cuándo se crearon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers importés sont hachés et horodatés à l'import. Cela prouve qu'ils n'ont pas changé depuis, pas quand ils ont été créés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file importati ricevono hash e marca temporale al momento dell'importazione. Ciò prova che non sono cambiati da allora, non quando sono stati creati."
          }
        }
      }
    },
    "Imported: the proof starts when the file was imported, not when it was made." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiert: Der Nachweis beginnt mit dem Import der Datei, nicht mit ihrer Entstehung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importado: la prueba empieza cuando se importó el archivo, no cuando se creó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importé : la preuve commence à l'import du fichier, pas à sa création."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importato: la prova parte dall'importazione del file, non dalla sua creazione."
          }
        }
      }
    },
