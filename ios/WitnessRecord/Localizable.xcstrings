    },
    "Why is my recording in pieces instead of one video?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum ist meine Aufnahme in Teilen statt in einem Video?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué mi grabación está en piezas y no en un solo video?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi mon enregistrement est-il en morceaux plutôt qu'en une seule vidéo ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché la mia registrazione è a pezzi invece che un unico video?"
