    "Recommended" : {
      "comment" : "A label displayed next to a checkmark in a",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfohlen"
          }
        },
