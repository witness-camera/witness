    "Placeholders: {date}, {time}, {location}, {session}. Each recording session's Drive subfolder is named from this template. Only applies to sessions started after you change it, existing folders keep their names." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platzhalter: {date}, {time}, {location}, {session}. Der Drive-Unterordner jeder Aufnahmesitzung wird nach dieser Vorlage benannt. Gilt nur für Sitzungen, die nach der Änderung gestartet werden, bestehende Ordner behalten ihren Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcadores de posición: {date}, {time}, {location}, {session}. La subcarpeta de Drive de cada sesión de grabación se nombra según esta plantilla. Solo se aplica a las sesiones iniciadas después de cambiarla, las carpetas existentes conservan su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaces réservés : {date}, {time}, {location}, {session}. Le sous-dossier Drive de chaque session d'enregistrement est nommé à partir de ce modèle. S'applique uniquement aux sessions démarrées après la modification, les dossiers existants conservent leur nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnaposto: {date}, {time}, {location}, {session}. La sottocartella Drive di ogni sessione di registrazione prende il nome da questo modello. Si applica solo alle sessioni avviate dopo la modifica, le cartelle esistenti mantengono il loro nome."
          }
        }
      }
    },
