    "Pro transcribes recordings and searches every case" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro transkribiert Aufnahmen und durchsucht alle Fälle"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro transcribe las grabaciones y busca en todos los casos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro transcrit les enregistrements et cherche dans tous les dossiers"
