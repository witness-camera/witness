      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen werden nur verwendet, um dich darauf hinzuweisen, dass eine Aufnahme die erneute Öffnung der App braucht, um das Speichern abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones solo se usan para avisarte de que una grabación necesita que reabras la app para terminar de guardarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
